# Environment Variables
# Copy this to .env and fill in values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
# SQLite (default) - no additional config needed
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/tgbothub

# Security
SECRET_KEY=your-secret-key-change-this
JWT_SECRET=your-jwt-secret-change-this
ENCRYPTION_KEY=your-encryption-key-change-this

# Session
SESSION_EXPIRY_DAYS=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Rate Limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# Telegram Bot API
TELEGRAM_API_BASE=https://api.telegram.org/bot{token}/{method}

# AI Integration
OPENAI_API_KEY=your-openai-api-key
AI_MODEL=gpt-3.5-turbo

# Email (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Vercel (frontend deployment)
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-project-id

# GitHub
GITHUB_TOKEN=your-github-token
GITHUB_REPO=your-username/tg-bot-hub

# Admin credentials (created on first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tgbothub.com
ADMIN_PASSWORD=Admin123!
